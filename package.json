{
  "name": "harness-threadbox",
  "version": "0.1.1",
  "description": "Console (TUI) viewer for AI coding-harness session logs. Live tail and history browsing. Claude Code first; Codex/Gemini/Grok via providers.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsdhgm/Harness-threadbox.git"
  },
  "homepage": "https://github.com/tsdhgm/Harness-threadbox#readme",
  "bugs": {
    "url": "https://github.com/tsdhgm/Harness-threadbox/issues"
  },
  "bin": {
    "hthreadbox": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "dev": "tsx src/cli.ts",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "smoke:tui": "bash scripts/tui-smoke.sh",
    "deb": "bash scripts/build-deb.sh"
  },
  "dependencies": {
    "get-east-asian-width": "^1.7.0",
    "markdown-it": "^14.0.0",
    "string-width": "^8.0.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
